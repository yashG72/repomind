# Copy this file to .env and fill in values. Never commit .env.
# Every variable is optional: the defaults shown here are what RepoMind uses if unset.

# --- Application ---
REPOMIND_ENVIRONMENT=development        # development | test | production
REPOMIND_LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
REPOMIND_LOG_FORMAT=json                # json | text

# --- Repository ingestion limits ---
REPOMIND_MAX_FILE_SIZE_BYTES=1000000    # skip files larger than ~1 MB
REPOMIND_MAX_REPO_SIZE_BYTES=200000000  # refuse repos with >~200 MB uncompressed content
REPOMIND_MAX_DOWNLOAD_BYTES=100000000   # abort archive downloads larger than ~100 MB
REPOMIND_MAX_FILES_PER_REPO=5000
REPOMIND_GITHUB_TIMEOUT_SECONDS=30

# --- Chunking ---
REPOMIND_CHUNK_MAX_LINES=80
REPOMIND_CHUNK_MAX_CHARS=6000

# --- Embeddings ---
# A Hugging Face model id, or a path to a local Sentence Transformers model folder.
REPOMIND_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# cpu (default) | mps (Apple silicon). The locked PyTorch build is CPU-only on Linux and
# Windows, so `cuda` needs a CUDA build of PyTorch installed instead (see README).
REPOMIND_EMBEDDING_DEVICE=cpu
REPOMIND_EMBEDDING_BATCH_SIZE=32
REPOMIND_EMBEDDING_CACHE_DIR=           # empty = default Hugging Face cache
REPOMIND_EMBEDDING_LOCAL_FILES_ONLY=false

# --- Qdrant vector store ---
# Leave REPOMIND_QDRANT_URL empty to use embedded local storage (no server needed).
# For Docker: http://localhost:6333   For Qdrant Cloud: https://<cluster>.cloud.qdrant.io
REPOMIND_QDRANT_URL=
REPOMIND_QDRANT_API_KEY=                # needed for Qdrant Cloud
REPOMIND_QDRANT_PATH=data/qdrant        # used only when REPOMIND_QDRANT_URL is empty
REPOMIND_QDRANT_COLLECTION=repomind_chunks
REPOMIND_QDRANT_TIMEOUT_SECONDS=10
REPOMIND_UPSERT_BATCH_SIZE=128

# --- Search ---
REPOMIND_SEARCH_DEFAULT_TOP_K=5
REPOMIND_SEARCH_MAX_QUERY_CHARS=2000
# Default mode when a request does not choose one: hybrid (semantic + keyword search, fused
# with Reciprocal Rank Fusion, then optionally reranked) | semantic (Phase 3 behaviour)
REPOMIND_SEARCH_MODE=hybrid
REPOMIND_SEARCH_SEMANTIC_CANDIDATES=50  # hybrid: chunks taken from semantic search (1-200)
REPOMIND_SEARCH_KEYWORD_CANDIDATES=50   # hybrid: chunks taken from keyword search (1-200)
REPOMIND_SEARCH_RRF_K=60                # RRF smoothing constant k in 1 / (k + rank)

# --- Reranking (hybrid mode) ---
# Off by default: in the evaluation it did not improve MRR over plain hybrid search and added
# about 0.5 s per search on a CPU. true = rerank every hybrid search by default. Either way a
# request can choose with "rerank": true or false.
REPOMIND_RERANK_ENABLED=false
# A Hugging Face cross-encoder id or a local model folder. Uses the embedding device, cache
# folder and local-files-only settings above. Downloaded on the first reranked search.
REPOMIND_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
REPOMIND_RERANK_MAX_CANDIDATES=20       # only the top fused chunks are reranked (1-100)

# --- LLM provider (not used yet; reserved for a later phase) ---
REPOMIND_LLM_PROVIDER=none
REPOMIND_LLM_MODEL=
REPOMIND_LLM_API_KEY=

# --- GitHub (optional; only raises API rate limits for public repositories) ---
REPOMIND_GITHUB_TOKEN=
